# Runtime environment
ENVIRONMENT=local
SERVICE_NAME=ai-recruiting-platform
LOG_LEVEL=INFO
ENABLE_JSON_LOGS=true
TELEMETRY_ENABLED=true

# API runtime
HOST=0.0.0.0
PORT=8000
WORKERS=1
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Worker runtime
QUEUE_NAME=default
PREFETCH_MULTIPLIER=1
MAX_RETRIES=3
TASK_SOFT_TIME_LIMIT_SECONDS=120

# Persistence and queueing
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_recruiting
BROKER_URL=redis://localhost:6379/0
RESULT_BACKEND_URL=redis://localhost:6379/1

# Search
OPENSEARCH_URL=http://localhost:9200
CANDIDATE_INDEX_NAME=candidates-v1
JOBS_INDEX_NAME=jobs-v1
SEMANTIC_PROVIDER=pgvector

# Integrations
ATS_PROVIDER=none
CRM_PROVIDER=none
WEBHOOK_SIGNING_SECRET=replace-me

# AI
PROVIDER=openai
MODEL=gpt-5-mini
TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1200

# Analytics and notifications
ENABLE_EVENT_EMISSION=true
EVENT_SINK=stdout
EMAIL_PROVIDER=none
FROM_EMAIL=noreply@example.com

# Governance defaults
REQUIRE_HUMAN_REVIEW_FOR_SCORING_OVERRIDES=true
OUTREACH_REQUIRES_SUPPRESSION_CHECK=true
ALLOW_EXTERNAL_DATA_EXPORT=false
